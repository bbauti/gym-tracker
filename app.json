{
  "expo": {
    "name": "Gym Tracker",
    "slug": "gym-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bbauti.gymtracker",
      "appleTeamId": "TW43Z9967V",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": ["es", "en"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "package": "com.bbauti.gymtracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "./plugins/withoutPushEntitlement.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A6FD6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0A2C52"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock with Face ID."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "quick_free": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#E6F4FE",
              "monochromeImage": "./assets/images/android-icon-monochrome.png"
            }
          }
        }
      ],
      "./plugins/withDynamicColor.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
